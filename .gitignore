# Build artifacts (slop-detector is compiled by slop-setup.sh from slop-detector.swift)
slop-detector
__pycache__/
*.pyc

# Runtime artifacts (may contain camera frames of the operator — never commit)
slop-capture.jpg
*.tmp

# Local Chrome profiles, logs
.slop-chrome-*/
*.log

# macOS
.DS_Store

# real stream creds must never land here — only the .template is committed
rig/obs/profiles/Rig2/service.json
service.json

# gesture forward config (secret token — never commit)
.slop-relay.env

# eye secrets (god password) — never commit
.slop-eye.env
