#!/bin/bash
# SLOP Lite launcher — runs slop-lite.sh inside iTerm2 (mid-call recovery:
# foreground + background + hand detector only; OBS and everything else is
# left running). iTerm2 because the hand detector's ScreenCaptureKit read of
# the OBS projector needs Screen Recording permission; Terminal.app lacks it.
#
# __REPO_DIR__ is baked in by install.sh (this file is a template in the repo).

open -ga iTerm
for i in $(seq 1 20); do
    if osascript -e 'tell application "iTerm2" to return name' >/dev/null 2>&1; then break; fi
    sleep 0.5
done

osascript <<'APPLESCRIPT'
tell application "iTerm2"
    activate
    set newWindow to (create window with default profile)
    tell current session of newWindow
        write text "bash __REPO_DIR__/slop-lite.sh"
    end tell
    -- park it where you keep it (matches ITERM_BOUNDS in slop-config.sh)
    try
        set bounds of newWindow to {-2549, 537, -1930, 1067}
    end try
end tell
APPLESCRIPT
